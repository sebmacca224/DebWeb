# Copy this file to backend/.env. Never commit backend/.env.
ENVIRONMENT=development

# Comma-separated public frontend origins. Use only the approved production
# origins after deployment; do not use * in production.
CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174

# Supabase: server-only values. The service role key must never go in js/config.js.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=author-assets

# Brevo: server-only values. Leave blank until a Brevo account/list is configured.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Deborah Fowler

# Private admin access: create Deborah's account in Supabase Auth, then list only
# her permitted email here. Generate a long random session secret for Railway.
ADMIN_EMAILS=
SESSION_SECRET=
